# Railway deployment Dockerfile for Huly Platform (Simplified)
# This version excludes the communication submodule for easier deployment

FROM node:20.11.0-alpine as builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Install Rush globally
RUN npm install -g @microsoft/rush pnpm@9.15.3

WORKDIR /app

# Copy rush configuration files first
COPY rush.json .
COPY common/config/rush common/config/rush

# Copy all package files
COPY . .

# Use the pre-cleaned rush.json (without comments and without communication packages)
COPY railway/rush-clean.json ./rush.json

# Remove .npmrc files that require GitHub authentication
RUN find . -name ".npmrc" -type f -delete

# Copy and run the patch script to remove communication submodule dependencies
COPY railway/patch-dependencies.js ./railway/
RUN node ./railway/patch-dependencies.js

# Remove all lock files since they reference packages we've removed
RUN find . -name "pnpm-lock.yaml" -type f -delete

# Run rush update to generate new lock file and install dependencies
RUN rush update

# Build core services only
RUN rush build --to @hcengineering/pod-server --to @hcengineering/pod-front --to @hcengineering/pod-account --to @hcengineering/pod-workspace --to @hcengineering/pod-collaborator
RUN rush bundle --to @hcengineering/pod-server --to @hcengineering/pod-front --to @hcengineering/pod-account --to @hcengineering/pod-workspace --to @hcengineering/pod-collaborator

# Production stage
FROM node:20.11.0-alpine

RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy built bundles from builder
COPY --from=builder /app/pods/server/bundle ./server/
COPY --from=builder /app/dev/prod/dist ./front/
COPY --from=builder /app/pods/account/bundle ./account/
COPY --from=builder /app/pods/workspace/bundle ./workspace/
COPY --from=builder /app/pods/collaborator/bundle ./collaborator/
COPY --from=builder /app/models/all/bundle/model.json ./model.json

# Copy startup script
COPY railway/start.sh ./start.sh
RUN chmod +x ./start.sh

# Expose ports
EXPOSE 8080 3000 3333 3078

# Start services
CMD ["./start.sh"]