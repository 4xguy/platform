{
  "$schema": "https://railway.app/railway.schema.json",
  "name": "huly-frontend",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "./railway/Dockerfile.front"
  },
  "deploy": {
    "numReplicas": 2,
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "domains": {
    "production": [
      {
        "domain": "app.yourdomain.com"
      }
    ]
  }
}