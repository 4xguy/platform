# Railway deployment Dockerfile for Account Service
FROM node:20.11.0-alpine as builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Install Rush globally
RUN npm install -g @microsoft/rush pnpm@9.15.3

WORKDIR /app

# Copy rush configuration files
COPY rush.json .
COPY common/config/rush common/config/rush

# Copy all source files
COPY . .

# Remove communication-related projects from rush.json
RUN node -e " \
    const fs = require('fs'); \
    const rush = JSON.parse(fs.readFileSync('rush.json')); \
    rush.projects = rush.projects.filter(p => !p.packageName.includes('communication')); \
    fs.writeFileSync('rush.json', JSON.stringify(rush, null, 2)); \
    "

# Clean up communication directory
RUN rm -rf communication || true

# Install dependencies
RUN rush install

# Build account service and its dependencies
RUN rush build --to @hcengineering/pod-account
RUN rush bundle --to @hcengineering/pod-account

# Production stage
FROM node:20.11.0-alpine

RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy built bundles
COPY --from=builder /app/pods/account/bundle ./

# Install production dependencies
RUN npm install express@^4.21.2 cors@^2.8.5 body-parser@^1.20.3

EXPOSE 3000

CMD ["node", "./bundle.js"]