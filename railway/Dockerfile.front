# Railway deployment Dockerfile for Frontend Service
FROM node:20.11.0-alpine as builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Install Rush globally
RUN npm install -g @microsoft/rush pnpm@9.15.3

WORKDIR /app

# Copy rush configuration files
COPY rush.json .
COPY common/config/rush common/config/rush

# Copy all source files
COPY . .

# Use the pre-cleaned rush.json (without comments and without communication packages)
COPY railway/rush-clean.json ./rush.json

# Clean up communication directory and lock files
RUN rm -rf communication || true
RUN find . -name "pnpm-lock.yaml" -type f -delete

# Run rush update to generate new lock file and install dependencies
RUN rush update

# Build only frontend and its dependencies
RUN rush build --to @hcengineering/prod
RUN rush bundle --to @hcengineering/prod
RUN rush package --to @hcengineering/prod

# Production stage
FROM nginx:alpine

# Copy built frontend
COPY --from=builder /app/dev/prod/dist /usr/share/nginx/html

# Copy nginx configuration
COPY railway/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]