# Railway deployment Dockerfile for Transactor/Server Service
FROM node:20.11.0-alpine as builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

# Install Rush globally
RUN npm install -g @microsoft/rush pnpm@9.15.3

WORKDIR /app

# Copy rush configuration files
COPY rush.json .
COPY common/config/rush common/config/rush

# Copy all source files
COPY . .

# Use the pre-cleaned rush.json (without comments and without communication packages)
COPY railway/rush-clean.json ./rush.json

# Clean up communication directory and lock file
RUN rm -rf communication || true
RUN rm -f common/config/rush/pnpm-lock.yaml

# Install dependencies (this will generate a new lock file)
RUN rush install

# Build server and its dependencies
RUN rush build --to @hcengineering/pod-server
RUN rush bundle --to @hcengineering/pod-server

# Production stage
FROM node:20.11.0-alpine

RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy built bundles
COPY --from=builder /app/pods/server/bundle ./
COPY --from=builder /app/models/all/bundle/model.json ./model.json

# Install production dependencies
RUN npm install ws@^8.18.2 msgpackr@^1.11.2

EXPOSE 3333

CMD ["node", "./bundle.js"]