# Railway Environment Variables Template for Huly Platform
# Copy this file to Railway's environment variables section

# === Core Configuration ===
NODE_ENV=production
SERVER_SECRET=your-secret-key-here
PLATFORM_ADMIN_EMAILS=admin@example.com

# === Database Configuration ===
# MongoDB (use Railway's MongoDB plugin URL)
MONGO_URL=${{MONGO_URL}}
DB_URL=${{MONGO_URL}}

# PostgreSQL/CockroachDB (alternative to MongoDB)
# DB_URL=${{DATABASE_URL}}
# DB_CR_URL=postgresql://username:password@host:port/database?sslmode=disable

# === Redis Configuration ===
REDIS_URL=${{REDIS_URL}}
QUEUE_CONFIG=redis://${{REDIS_URL}}

# === Storage Configuration (MinIO) ===
STORAGE_CONFIG=minio|minio-bucket|${{MINIO_ENDPOINT}}|${{MINIO_ACCESS_KEY}}|${{MINIO_SECRET_KEY}}
MINIO_ENDPOINT=your-minio-endpoint
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=huly-files

# === Service URLs ===
# These should use Railway's internal networking
ACCOUNTS_URL=http://account.railway.internal:3000
TRANSACTOR_URL=ws://server.railway.internal:3333
COLLABORATOR_URL=ws://collaborator.railway.internal:3078
FRONT_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
STATS_URL=http://stats.railway.internal:4900
FULLTEXT_URL=http://fulltext.railway.internal:4700
WORKSPACE_URL=http://workspace.railway.internal:3001

# === Email Configuration ===
MAIL_URL=smtp://username:password@smtp.example.com:587
MAIL_FROM=noreply@example.com

# === File Upload Configuration ===
UPLOAD_URL=/upload/form-data/:workspace
FILES_URL=/blob/:workspace/:blobId/:filename
PREVIEW_CONFIG=image|/image/fit=cover,width=:width,height=:height,dpr=:dpr/:workspace/:blobId;video|/meta/:workspace/:blobId

# === Region Configuration ===
REGION=railway
REGION_INFO=Railway

# === Performance Configuration ===
WORKSPACE_LIMIT_PER_USER=100
WS_LIVENESS_DAYS=7
ENABLE_COMPRESSION=true
METRICS_CONSOLE=false

# === Feature Flags ===
DISABLE_SIGNUP=false
LAST_NAME_FIRST=false
COMMUNICATION_API_ENABLED=true

# === Model Configuration ===
MODEL_VERSION=latest
MODEL_JSON=/app/model.json

# === Branding ===
BRANDING_PATH=/app/branding.json
BRANDING_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/branding.json

# === Backup Configuration (Optional) ===
# BACKUP_STORAGE=minio|backup-bucket|endpoint|access-key|secret-key
# BACKUP_BUCKET_NAME=huly-backups

# === AI Bot Configuration (Optional) ===
# AI_BOT_URL=http://ai-bot.railway.internal:4010

# === External Services (Optional) ===
# GITHUB_URL=http://github.railway.internal:3500
# TELEGRAM_URL=http://telegram.railway.internal:8086
# CALENDAR_URL=http://calendar.railway.internal:8095
# GMAIL_URL=http://gmail.railway.internal:8088
# REKONI_URL=http://rekoni.railway.internal:4004
# PRINT_URL=http://print.railway.internal:4005
# SIGN_URL=http://sign.railway.internal:4006
# ANALYTICS_COLLECTOR_URL=http://analytics.railway.internal:4017

# === Desktop Updates (Optional) ===
# DESKTOP_UPDATES_URL=https://dist.huly.io
# DESKTOP_UPDATES_CHANNEL=stable